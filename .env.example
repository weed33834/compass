# ============ 核心（必填） ============
# 数据库连接（Prisma 格式）
#   本地:        postgresql://postgres:postgres@localhost:5432/compass?schema=public
#   Neon:        postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#   Docker 内:   postgresql://compass:change-me@db:5432/compass?schema=public
DATABASE_URL=

# NextAuth 回调与 Cookie 域名（生产必须 https，结尾无斜杠）
NEXTAUTH_URL=https://your-domain.com

# NextAuth 会话签名密钥（务必随机且保密，生成: openssl rand -base64 32）
NEXTAUTH_SECRET=

# 站点对外地址（用于 SEO 的 metadataBase / canonical / sitemap / robots）
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ============ 应用 ============
APP_PORT=3000
APP_NAME=Compass
NEXT_PUBLIC_DEFAULT_LOCALE=zh-CN

# ============ 反向代理 ============
# 部署在 Caddy / Nginx 之后时，填写可信代理 IP，用于正确获取客户端真实 IP（影响限流）
TRUSTED_PROXY_IPS=127.0.0.1

# ============ 第三方登录（可选） ============
# 启用的 OAuth 提供方，逗号分隔；留空则仅邮箱密码登录
NEXT_PUBLIC_OAUTH_PROVIDERS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============ 邮件（可选，忘记密码用） ============
# 未配置时注册/登录仍正常，但「发送重置邮件」会失败
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@your-domain.com

# ============ AI 出题（可选） ============
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000
AI_TIMEOUT_MS=60000

# ============ 日志 ============
LOG_LEVEL=info
